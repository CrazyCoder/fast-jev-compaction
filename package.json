{
  "name": "jetcompact",
  "version": "0.11.0",
  "description": "Verbatim context compaction for LLM agents, guided by a fast decision model (TypeSafe Jev or OpenAI Decisions).",
  "type": "module",
  "license": "MIT",
  "author": "CrazyCoder (https://github.com/CrazyCoder)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrazyCoder/jetcompact.git"
  },
  "homepage": "https://github.com/CrazyCoder/jetcompact#readme",
  "bugs": "https://github.com/CrazyCoder/jetcompact/issues",
  "keywords": [
    "llm",
    "agent",
    "context",
    "compaction",
    "claude-code",
    "jev",
    "typesafe"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit && npm run typecheck:hooks && npm run typecheck:tools",
    "test": "vitest run",
    "test:hooks:host": "node scripts/test-host-hooks.mjs",
    "demo": "tsx examples/demo.ts",
    "typecheck:hooks": "tsc -p tsconfig.hooks.json",
    "validate:plugin": "claude plugin validate .claude-plugin/plugin.json",
    "check:version": "node scripts/check-version.mjs",
    "replay": "tsx tools/replay/run.ts",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "jscpd:list": "jscpd -c .jscpd.json --reporters ai",
    "jscpd:baseline": "jscpd -c .jscpd.json --update-baseline"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jscpd": "5.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
